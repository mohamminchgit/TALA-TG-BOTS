# Telegram API Credentials
TELEGRAM_API_ID=your_api_id_here
TELEGRAM_API_HASH=your_api_hash_here

# Source Bot Configuration
SOURCE_ALIAS=source_bot_alias
SOURCE_GROUP=your_source_group_id
SOURCE_SESSION_FILE=sessions/source.session
SOURCE_PHONE_NUMBER=your_source_phone_number
SOURCE_PHONE_PASSWORD=your_source_2fa_password_if_needed
SOURCE_ACK_MESSAGES=false
SOURCE_CONFIRMATION_TIMEOUT_SECONDS=15

# Destination Bot Configuration
DESTINATION_ALIAS=destination_bot_alias
DESTINATION_GROUP=your_destination_group_id
DESTINATION_SESSION_FILE=sessions/destination.session
DESTINATION_PHONE_NUMBER=your_destination_phone_number
DESTINATION_PHONE_PASSWORD=your_destination_2fa_password_if_needed
DESTINATION_ACK_MESSAGES=false
DESTINATION_CONFIRMATION_TIMEOUT_SECONDS=15

# Redis Configuration
REDIS_URL=redis://redis:6379/0

# Database Configuration
DATABASE_PATH=data/database.db

# Logging
LOG_LEVEL=INFO

# Engine Configuration
ENGINE_RECONCILIATION_INTERVAL_SECONDS=60
ENGINE_STALE_ORDER_SECONDS=900
MINIMUM_PROFIT_SPREAD=10
EXECUTED_TRADES_CACHE_KEY=executed_trades_cache
EXECUTED_CACHE_EXPIRATION_SECONDS=3600

# Predictive Market Making
PREDICTIVE_PRICE_DELTA=10
PREDICTIVE_SUFFIX_DIGITS=4
SPECULATIVE_TRADE_TIMEOUT_SECONDS=60
SOURCE_ORDER_EXPIRY_SECONDS=60

# Exit Strategy Configuration
EXIT_STRATEGY_TIMEOUT_SECONDS=2
EMERGENCY_TIMEOUT_SECONDS=4
STOP_LOSS_PRICE_OFFSET=5
CIRCUIT_BREAKER_DURATION_MINUTES=10

# Trade Policy
FIXED_SPREAD_DELTA=10
BASE_CARRY_LIMIT=1
OPPORTUNITY_CARRY_LIMIT=3

# Auto Cancel Acknowledgment Delay
AUTO_N_DELAY_SECONDS=3

# Admin Bot Configuration (Optional)
ADMIN_BOT_TOKEN=your_admin_bot_token_if_enabled
ADMIN_BOT_CHAT_ID=your_admin_chat_id_if_enabled
ADMIN_STATUS_REFRESH_SECONDS=30
